# Use a modern, slim Node.js base image
FROM node:24-slim

# Set the root working directory for the entire application
WORKDIR /app

# Copy the compiled contract artifacts first, as they are needed by the oracle
COPY ./artifacts ./artifacts

# Copy shared-schema submodule before install — oracle depends on it via "../packages/shared-schema"
COPY ./packages/shared-schema ./packages/shared-schema

# Now, set the working directory to the oracle's specific subdirectory
WORKDIR /app/oracle

# Copy the oracle's package files and install production dependencies
COPY ./oracle/package*.json ./

# The Brain ships compiled dist/ built with Bun on the HOST (image:build:*
# scripts run prepare:brain first) — this Node image can't build it. Guard so
# a missing dist fails the build loudly instead of at container start.
COPY ./oracle/packages/sense-ai-brain ./packages/sense-ai-brain
RUN test -f packages/sense-ai-brain/dist/index.js || \
    (echo "sense-ai-brain dist/ missing — run 'bun run prepare:brain' before docker build" && exit 1)

RUN npm install --omit=dev --no-progress

# Copy the oracle's source code into the current directory (/app/oracle)
COPY ./oracle/src ./src

# The command will be run from /app/oracle, so the entrypoint path is simple
CMD ["node", "src/index.js"]