# Wallet private key for deployment and for the ROFL oracle to use
PRIVATE_KEY=your_private_key_here

# The public key corresponding to the PRIVATE_KEY above. Used for encryption.
# This should be the uncompressed public key (132 characters, starting with 0x04).
PUBLIC_KEY=your_rofl_worker_public_key_here

# User's wallet private key (for testing client-side interactions)
USER_PRIVATE_KEY=your_user_private_key_here

# The addresses of your deployed contracts.
TOKEN_CONTRACT_ADDRESS=0xYourERC20TokenAddressHere # Optional: Used for ERC-20 payments on Base. If blank/omitted on Sapphire, native TEST/ROSE is used.
AI_AGENT_CONTRACT_ADDRESS=0xYourAIAgentAddressHere
AI_AGENT_ESCROW_CONTRACT_ADDRESS=0xYourAIAgentEscrowAddressHere

# Domain used for SIWE authentication
DOMAIN=example.com

# --- Deploying the agent and escrow (scripts/deploy.js) ---
# On an EVM network the deploy reads DEPLOY_MODE and both pair addresses above from this file
# alone. For DEPLOY_MODE=fresh on a live network it also reads TOKEN_CONTRACT_ADDRESS, DOMAIN and
# every setting below from this file alone, and refuses one set only in the root .env or the shell.
# fresh (deploy a new pair; both pair addresses empty) or upgrade (upgrade the pair they name).
DEPLOY_MODE=
# The fee token's symbol: the deploy reads the token's symbol and refuses when it differs.
EXPECTED_FEE_TOKEN_SYMBOL=
# Where fees accrue. Required for a fresh pair on a live network.
TREASURY_ADDRESS=
# The address the oracle answers from. Unset, the deploy wallet is the first oracle.
ORACLE_ADDRESS=
# Fees a fresh escrow starts with, in wei of the fee token (decimal digits only; one token of 18
# decimals is 1000000000000000000). Required for a fresh pair on a live network.
INITIAL_PROMPT_FEE=
# Fee for cancelling a prompt, in wei.
INITIAL_CANCELLATION_FEE=
# Fee for renaming or deleting a conversation, in wei.
INITIAL_METADATA_FEE=
# Fee for branching a conversation, in wei.
INITIAL_BRANCH_FEE=

# RPC endpoints (only one set will be used per environment)
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_SEPOLIA_TESTNET_RPC=https://sepolia.base.org
SAPPHIRE_MAINNET_RPC=https://sapphire.oasis.io
SAPPHIRE_TESTNET_RPC=https://testnet.sapphire.oasis.io
SAPPHIRE_LOCALNET_RPC=http://localhost:8545

# Etherscan API key
ETHERSCAN_API_KEY=your_ethscan_api_key_here

# CoinMarketCap API key
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Flag to report gas usage in tests
REPORT_GAS=true
