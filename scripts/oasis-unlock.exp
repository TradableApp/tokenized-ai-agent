#!/usr/bin/env expect -f
# Run any `oasis` command non-interactively. The account passphrase comes from the macOS
# login Keychain (item `oasis-passphrase-<account>`, taken from the `--account` flag, or
# `OASIS_PASSPHRASE_SERVICE`), the ESC[6n terminal probe is answered, and y/N confirmations
# are answered "y". Nothing secret is ever printed.
#
#   expect scripts/oasis-unlock.exp rofl update --deployment base-testnet --account oasis_testnet --gas-limit 200000
#   bun run oasis:unlock rofl deploy --deployment base-testnet --account oasis_testnet --offer playground_short
#
# Exit codes: child's exit status · 1 timeout · 2 no Keychain item · 3 passphrase rejected.
# See docs/BASE_TESTNET_DEPLOY_RUNBOOK.md § "Non-interactive Oasis CLI".
set timeout 900
match_max 200000
set stty_init "rows 50 columns 200"
# Keychain item is per CLI account: oasis-passphrase-<account> from the --account flag,
# falling back to the shared oasis-passphrase item (the log wrapper's).
set svc "oasis-passphrase"
set i [lsearch -exact $argv "--account"]
if {$i >= 0 && $i + 1 < [llength $argv]} { set svc "oasis-passphrase-[lindex $argv [expr {$i + 1}]]" }
if {[info exists env(OASIS_PASSPHRASE_SERVICE)]} { set svc $env(OASIS_PASSPHRASE_SERVICE) }
if {[catch {exec security find-generic-password -s $svc -a $env(USER) -w} pass]} {
    send_user "error: no Keychain item '$svc' for user $env(USER).\n"; exit 2
}
if {[llength $argv] == 0} { send_user "usage: oasis-unlock.exp <oasis args...>\n"; exit 1 }
spawn -noecho oasis {*}$argv
set sent 0
expect {
    -nocase -re "passphrase" {
        if {$sent == 0} { send -- "$pass\r"; set sent 1; exp_continue }
        send_user "\n\[oasis-unlock] passphrase rejected — check the Keychain item '$svc'\n"; exit 3
    }
    # The y/N branch MUST precede the DSR-probe branch: a large transaction dump can deliver
    # "Sign this transaction? (y/N)" and the probe in one read, and a match discards everything
    # before it, so the probe matching first would swallow the prompt and the answer never fires.
    -nocase -re "\\(y/n\\)|\\\[y/n\\\]|\\\[y/N\\\]|\\\[Y/n\\\]" { send -- "y\r"; exp_continue }
    -re "\x1b\\\[6n" { send -- "\x1b\[50;200R"; exp_continue }
    timeout { send_user "\n\[oasis-unlock] TIMEOUT after ${timeout}s (passphrase sent: $sent)\n"; exit 1 }
    eof {}
}
catch wait result
exit [lindex $result 3]
